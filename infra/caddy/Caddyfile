# Consola y API de la central. El certificado lo emite y renueva Caddy solo.
#
# El receptor DC-09 NO pasa por aquí: los paneles hablan TCP y UDP crudo contra
# el puerto 9999, sin HTTP, así que no puede haber proxy en el medio.

{$DOMINIO_CONSOLA} {
	encode gzip

	# La API y el WebSocket de alarmas en vivo. Caddy negocia el upgrade solo.
	handle /api/* {
		reverse_proxy api:3000
	}

	# La app Android se distribuye desde acá (APK, versión publicada y página
	# de descarga). Los archivos viven en /opt/monitoring/app del servidor.
	handle_path /app/* {
		root * /srv/app
		file_server
	}

	# La vista previa con clave (/previa) se retiró: la página comercial ya
	# vive en falconseguridadtotal.com (bloque de abajo).
	redir /previa/* https://falconseguridadtotal.com/ permanent

	# Privacidad y términos viven en el dominio principal desde el 15-10. Las
	# direcciones de acá siguen respondiendo, con un salto, para no romper
	# enlaces viejos (incluido el que se cargó primero en Google Play).
	@legales_viejos path /privacidad /privacidad/* /terminos /terminos/*
	redir @legales_viejos https://falconseguridadtotal.com{uri} permanent

	# La consola es una aplicación de una sola página: cualquier ruta que no
	# sea un archivo real devuelve index.html para que el enrutador la resuelva.
	# El {path}/index.html del medio es para /privacidad/ y /terminos/, que son
	# documentos sueltos y no rutas de la consola: Google Play exige una URL
	# pública y estable para la política de privacidad.
	handle {
		root * /srv
		try_files {path} {path}/index.html /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# El sitio es solo HTTPS: que el navegador no vuelva a intentar por HTTP
		# ni siquiera la primera vez de cada visita (un año).
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}

	log {
		output file /var/log/caddy/acceso.log {
			roll_size 20mb
			roll_keep 5
		}
		# El canal en vivo (/api/ws) lleva el token de sesión en la URL, y el
		# registro lo guardaba tal cual: credenciales válidas por 30 días
		# escritas en un archivo. Se borra del registro antes de escribirlo.
		format filter {
			request>uri query {
				replace token REDACTADO
			}
			request>headers>Authorization replace REDACTADO
		}
	}
}

# Página comercial pública de Falcón Seguridad Total (desde el 15-10-2026; antes
# el dominio apuntaba al Windows con el portal de 365, que ya nadie usa). La
# consola y la app siguen en monitoreo.falconseguridadtotal.com.
falconseguridadtotal.com {
	encode gzip

	# El formulario de contacto de la página postea acá (mismo origen)
	handle /api/contacto {
		reverse_proxy api:3000
	}

	# Privacidad y términos: dirección oficial (la que va en Google Play). Son
	# los documentos de la consola; monitoreo.* redirige acá
	@legales path /privacidad /privacidad/* /terminos /terminos/*
	handle @legales {
		root * /srv
		try_files {path} {path}/index.html
		file_server
	}

	handle {
		root * /srv/landing
		try_files {path} {path}/index.html /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
	}
}

# www es un CNAME al dominio en GoDaddy: una sola dirección canónica
www.falconseguridadtotal.com {
	redir https://falconseguridadtotal.com{uri} permanent
}
