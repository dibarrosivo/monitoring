# Copiar como .env junto al programa y ajustar.

# Identificación ante la central
BRIDGE_NOMBRE=pc-central-1
BRIDGE_SERVIDOR=http://192.168.0.184:3000
BRIDGE_TOKEN=cambiar-por-el-token-del-servidor

# Origen de las tramas: 'serie' (receptor por COM) o 'tcp' (receptor en red)
BRIDGE_FUENTE=serie
BRIDGE_PUERTO_SERIE=COM1
BRIDGE_BAUDIOS=9600
BRIDGE_DATA_BITS=8
BRIDGE_PARIDAD=none
BRIDGE_STOP_BITS=1

# Solo para BRIDGE_FUENTE=tcp
BRIDGE_TCP_HOST=127.0.0.1
BRIDGE_TCP_PUERTO=10001

# Responder ACK (0x06) al receptor; dejar en 'si' salvo que el receptor no lo espere
BRIDGE_ACK=si

BRIDGE_LATIDO_SEG=60
BRIDGE_ARCHIVO_COLA=cola-pendiente.jsonl
BRIDGE_NIVEL_LOG=info
