{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@monitoring/shared": ["packages/shared/src/index.ts"],
      "@monitoring/protocols": ["packages/protocols/src/index.ts"],
      "@monitoring/db": ["packages/db/src/index.ts"],
      "@monitoring/engine": ["packages/engine/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/pruebas/**/*.ts", "tools/*/src/**/*.ts"],
  "exclude": ["packages/console"]
}
