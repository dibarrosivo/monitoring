# Copiar a .env y ajustar. En producción este archivo se genera desde keys.json (VPS).

# Base de datos
DATABASE_URL=postgres://monitoring:monitoring@localhost:5433/monitoring

# Receptor de señales
PUERTO_DC09_TCP=9999
PUERTO_DC09_UDP=9999
# Clave AES para DC-09 cifrado (hex de 32, 48 o 64 caracteres; vacío = solo tramas en claro)
DC09_CLAVE_AES=

# Escucha del receptor PIMA por TCP crudo (vacío = deshabilitado).
# Lo alimenta el programa de la central, que puede entregar la misma entrada
# serie a varios destinos a la vez.
PUERTO_PIMA_TCP=10050

# Escucha Sur-Gard MLR2 por TCP con ACK (vacío = deshabilitado). Para receptores
# por IP que entregan Contact ID en ese formato, como el EBS OSM: se lo apunta
# acá como un "analizador" más y cada trama se confirma con ACK.
PUERTO_SURGARD_TCP=10060

# Retención del diario crudo de señales, en días (vacío = no se borra nada).
# Los eventos y las alarmas nunca se depuran.
RETENCION_SENALES_DIAS=

# Puente de la central (packages/pima-bridge): mismo valor en ambos lados.
# Sin este token, el servidor rechaza todo lo que mande el puente.
BRIDGE_TOKEN=

# Control remoto de paneles Hikvision (OpenAPI de Hik-Partner Pro).
# Sin estas credenciales el control queda inactivo y los comandos se rechazan
# con un motivo legible, sin romper nada. Se solicitan desde la cuenta de
# Hik-Partner Pro. Requiere AX Pro V1.2.7 o superior en el panel.
HIK_OPENAPI_CLAVE=
HIK_OPENAPI_SECRETO=

# Tasa oficial del dólar (BCV): la API la lee de www.bcv.org.ve cada tantas
# horas (0 = apagado) y la guarda por fecha de valor. Los planes están en USD
# y la conversión a bolívares se hace al consultar.
TASA_BCV_CADA_HORAS=12

# API
PUERTO_API=3000
JWT_SECRETO=cambiar-en-produccion

# Registro
NIVEL_LOG=info
