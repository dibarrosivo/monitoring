# Copiar a .env y ajustar. En producción este archivo se genera desde keys.json (VPS).

# Base de datos
DATABASE_URL=postgres://monitoring:monitoring@localhost:5433/monitoring

# Receptor de señales
PUERTO_DC09_TCP=9999
PUERTO_DC09_UDP=9999
# Clave AES para DC-09 cifrado (vacío = solo tramas en claro)
DC09_CLAVE_AES=

# API
PUERTO_API=3000
JWT_SECRETO=cambiar-en-produccion

# Registro
NIVEL_LOG=info
